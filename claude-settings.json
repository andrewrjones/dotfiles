{
  "permissions": {
    "allow": [
      "Artifact",
      "Bash(.venv/bin/python3 -m pytest *)",
      "Bash(cue *)",
      "Bash(echo \"exit:$?\")",
      "Bash(echo \"exit code: $?\")",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(git *)",
      "Bash(mise run *)",
      "Bash(python -m pytest *)",
      "Bash(tb --cloud workspace current)",
      "Bash(tb -h)",
      "Bash(tb --local *)",
      "Bash(tb --version)",
      "Bash(tb auth info *)",
      "Bash(tb branch *)",
      "Bash(tb check *)",
      "Bash(tb datasource ls *)",
      "Bash(tb info *)",
      "Bash(tb pipe ls *)",
      "Bash(tb sql *)",
      "Bash(tb --no-version-warning sql *)",
      "Bash(tb test *)",
      "Bash(tb workspace current *)",
      "Bash(uv --version)",
      "Bash(uv init *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(xargs *)",
      "Skill(artifact-design)",
      "Skill(code-review)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Slack__slack_search_public_and_private"
    ],
    "deny": [
      "Bash(git push --force*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "model": "claude-opus-4-8",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
